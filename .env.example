# Which data source to use: "mock" (default, synthetic data) or "yahoo" (delayed, unofficial, no key).
MARKET_DATA_PROVIDER=mock

# Yahoo symbols. IHSG and LQ45 default to ^JKSE and ^JKLQ45 (verified public symbols).
# IDX30 / IDX80 have no confirmed Yahoo symbol: leave empty (shown as "unavailable")
# or set one you have verified yourself.
# YAHOO_SYMBOL_IHSG=^JKSE
# YAHOO_SYMBOL_LQ45=^JKLQ45
# YAHOO_SYMBOL_IDX30=
# YAHOO_SYMBOL_IDX80=

# Reserved for a keyed vendor you add under src/services/market-data/providers/.
# Server-side only: never prefix with NEXT_PUBLIC_.
# MARKET_DATA_API_KEY=
